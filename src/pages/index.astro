---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const dateFormat = new Intl.DateTimeFormat('en', {
	day: 'numeric',
	month: 'short',
});

const palette = [
	{ name: 'Core ink', value: '#663732' },
	{ name: 'Warm coral', value: '#CC6D64' },
	{ name: 'Bright aqua', value: '#64C3CC' },
	{ name: 'Soft mist', value: '#98C7CC' },
	{ name: 'Deep teal', value: '#326166' },
];
---

<SiteLayout
	title="Fieldnotes — a journal on design"
	description="Fieldnotes is an independent journal about the ideas, objects, and details shaping how we live."
>
	<main>
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-inner">
				<div class="hero-copy">
					<h1 id="hero-title">Looking closer.<br /><span>Thinking wider.</span></h1>
					<p>
						Notes on the ideas, objects, and details shaping how we live. Made for the
						curious, collected in one place.
					</p>
					<div class="hero-actions">
						<a class="action action-primary" href={posts[0] ? `/journal/${posts[0].id}/` : '#journal-title'}>
							Read the journal
							<svg aria-hidden="true" viewBox="0 0 18 18">
								<path d="M3 9h11M9 4l5 5-5 5" />
							</svg>
						</a>
						<a class="action action-secondary" href="#guides">Browse the guide preview</a>
					</div>
				</div>

				<div class="hero-art" aria-hidden="true">
					<svg viewBox="0 0 520 400" role="presentation">
						<path class="art-floor" d="M42 337c91-18 320-18 436 0" />
						<path class="art-wall" d="M96 337V105h328v232" />
						<path class="art-window" d="M143 287V155h108v132m-108-66h108" />
						<path class="art-window-light" d="m251 155 67-43v175h-67" />
						<path class="art-door" d="M300 337V230c0-39 29-70 65-70s65 31 65 70v107" />
						<path class="art-door-detail" d="M300 274h130" />
						<path class="art-seat" d="M177 337v-31h42v31m-52-31h62" />
						<circle class="art-sun" cx="363" cy="93" r="19" />
						<path class="art-sun-ray" d="M363 48V33m0 120v-15m45-45h15m-120 0h15m77-32 11-11m-85 85 11-11" />
						<path class="art-plant" d="M455 337v-56m0 25c-23-2-31-17-31-31 17 3 28 13 31 31m0-10c3-25 14-38 32-41-1 20-11 34-32 41" />
						<path class="art-mark" d="M112 337h352" />
					</svg>
				</div>
			</div>
			<div class="hero-rule" aria-hidden="true">
				<span></span><span></span><span></span><span></span><span></span>
			</div>
		</section>

		<section class="journal shell" aria-labelledby="journal-title">
			<div class="section-heading">
				<h2 id="journal-title">From the journal</h2>
				<span class="note-count">
					<span>{posts.length.toString().padStart(2, '0')}</span>
					{posts.length === 1 ? 'published note' : 'published notes'}
				</span>
			</div>

			<div class="journal-grid">
				{posts.length > 0 ? (
					posts.map((post, index) => (
							<article class:list={['journal-card', { featured: index === 0 }]}>
								<a class="card-link" href={`/journal/${post.id}/`}>
									<span class="card-art threshold-art" aria-hidden="true">
										<svg viewBox="0 0 360 240">
											<path d="M55 192h250M92 192V92h176v100M92 142h176" />
											<path class="art-accent" d="M148 192v-55c0-33 25-59 57-59s57 26 57 59v55" />
											<path class="art-muted" d="M119 192v-30h27v30m125-72 34-29v101" />
										</svg>
									</span>
									<span class="card-copy">
										<span class="post-meta">
											<span>{post.data.category}</span>
											<time datetime={post.data.publishedAt.toISOString()}>
												{dateFormat.format(post.data.publishedAt)}
											</time>
										</span>
										<h3>{post.data.title}</h3>
										<span class="post-description">{post.data.description}</span>
										<span class="card-action">
											Read the note
											<svg aria-hidden="true" viewBox="0 0 18 18">
												<path d="M3 9h11M9 4l5 5-5 5" />
											</svg>
										</span>
									</span>
									<span class="registration-rail" aria-hidden="true"></span>
								</a>
							</article>
						))
				) : (
					<p class="empty-state">New notes are on their way. Please check back soon.</p>
				)}

					<article class="journal-card placeholder" id="guides">
						<div class="card-art guide-art" aria-hidden="true">
							<svg viewBox="0 0 360 240">
								<path d="M91 63h178v122H91zM180 63v122m-89-61h178" />
								<path class="art-accent" d="M116 162V93h43v69m42 0v-36h43v36" />
								<path class="art-muted" d="m136 114 9-10 9 10m25 45h-14" />
							</svg>
						</div>
						<div class="card-copy">
							<div class="post-meta"><span>Field guides</span><span>Preview only</span></div>
							<h3>A field guide to the everyday</h3>
							<p class="post-description">Visual placeholder — no guide is published here.</p>
						</div>
					</article>

					<article class="journal-card placeholder" id="studio-preview">
						<div class="card-art studio-art" aria-hidden="true">
							<svg viewBox="0 0 360 240">
								<path d="M69 177h222M95 177v-72h170v72M95 141h170" />
								<path class="art-accent" d="M129 105V75h102v30m-77 72v-26h52v26" />
								<circle class="art-muted" cx="180" cy="89" r="13" />
							</svg>
						</div>
						<div class="card-copy">
							<div class="post-meta"><span>Studio notes</span><span>Preview only</span></div>
							<h3>Ideas taking shape</h3>
							<p class="post-description">Visual placeholder — no studio stories are published here.</p>
						</div>
					</article>
				</div>
		</section>

		<section class="palette-feature" id="palette-guide" aria-labelledby="palette-title">
			<div class="palette-inner shell">
				<div class="palette-copy">
					<h2 id="palette-title">Color sets the scene.</h2>
					<p>
						Five colors, held in conversation: warm ink and coral alongside the
						quieter tones of aqua, mist, and teal.
					</p>
					<a class="action action-primary" href={posts[0] ? `/journal/${posts[0].id}/` : '#journal-title'}>
						Explore the latest note
						<svg aria-hidden="true" viewBox="0 0 18 18">
							<path d="M3 9h11M9 4l5 5-5 5" />
						</svg>
					</a>
				</div>
				<ol class="palette-swatches" aria-label="Fieldnotes brand colors">
					{
						palette.map((color) => (
							<li>
								<span class="swatch" style={`--swatch-color: ${color.value}`}></span>
								<span class="swatch-name">{color.name}</span>
								<code>{color.value}</code>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="newsletter shell" id="newsletter" aria-labelledby="newsletter-title">
			<div class="newsletter-copy">
				<h2 id="newsletter-title">A note for the in-between.</h2>
				<p>A visual preview of a future letter from Fieldnotes.</p>
			</div>
			<form class="newsletter-preview" aria-describedby="newsletter-note">
				<label class="visually-hidden" for="newsletter-email">Email address</label>
				<input id="newsletter-email" type="email" placeholder="you@email.com" disabled />
				<button type="button" disabled>Coming soon</button>
				<p id="newsletter-note">Preview only — email sign-ups are not available.</p>
			</form>
		</section>
	</main>
</SiteLayout>

<style>
	.shell {
		margin-inline: auto;
		max-width: 1440px;
		padding-inline: clamp(22px, 6.5vw, 96px);
	}
	.hero {
		background: var(--color-teal-deep);
		color: var(--color-paper);
	}
	.hero-inner {
		align-items: stretch;
		display: grid;
		gap: clamp(36px, 5vw, 72px);
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		margin: 0 auto;
		max-width: 1440px;
		min-height: 468px;
		padding: 42px clamp(22px, 3.6vw, 52px);
	}
	.hero-copy {
		align-self: center;
		max-width: 600px;
		padding-block: 18px;
	}
	h1 {
		color: var(--color-paper);
		font: 560 clamp(3rem, 5.5vw, 5.4rem)/.96 var(--font-display);
		letter-spacing: -.045em;
		margin: 0;
		max-width: 12ch;
	}
	h1 span { color: var(--color-mist); }
	.hero-copy > p {
		color: var(--color-mist-wash);
		font-size: clamp(15px, 1.3vw, 17px);
		line-height: 1.7;
		margin: 24px 0 0;
		max-width: 52ch;
	}
	.hero-actions {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 25px;
	}
	.action {
		align-items: center;
		display: inline-flex;
		font-size: 12px;
		font-weight: 650;
		gap: 14px;
		min-height: 44px;
		padding: 12px 17px;
		text-decoration: none;
		transition: background-color 180ms ease-out, color 180ms ease-out;
	}
	.action svg, .card-action svg {
		fill: none;
		height: 17px;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-linejoin: miter;
		stroke-width: 1.4;
		width: 17px;
	}
	.action-primary {
		background: var(--color-coral);
		color: var(--color-ink-on-coral);
	}
	.action-primary:hover {
		background: var(--color-aqua);
		color: var(--color-ink-on-coral);
	}
	.action-secondary {
		border: 1px solid rgb(227 240 241 / 45%);
		color: var(--color-paper);
	}
	.action-secondary:hover {
		background: var(--color-paper);
		color: var(--color-teal-deep);
	}
	.hero-art {
		align-items: center;
		background: var(--color-teal-night);
		display: flex;
		justify-content: center;
		min-height: 380px;
		overflow: hidden;
		padding: clamp(12px, 2.2vw, 30px);
	}
	.hero-art svg {
		height: auto;
		max-height: 380px;
		max-width: 560px;
		overflow: visible;
		width: 100%;
	}
	.hero-art path {
		fill: none;
		stroke: var(--color-mist);
		stroke-linecap: square;
		stroke-linejoin: miter;
		stroke-width: 2;
	}
	.hero-art .art-floor { opacity: .45; }
	.hero-art .art-window-light {
		fill: rgb(100 195 204 / 14%);
		stroke: var(--color-aqua);
	}
	.hero-art .art-door,
	.hero-art .art-seat,
	.hero-art .art-mark { stroke: var(--color-coral); }
	.hero-art .art-sun {
		fill: var(--color-aqua);
		stroke: none;
	}
	.hero-art .art-sun-ray,
	.hero-art .art-plant { stroke: var(--color-soft-mist); }
	.hero-rule {
		display: grid;
		grid-template-columns: 1.1fr .9fr 1.2fr .8fr 1fr;
		height: 6px;
	}
	.hero-rule span:nth-child(1) { background: var(--color-ink); }
	.hero-rule span:nth-child(2) { background: var(--color-coral); }
	.hero-rule span:nth-child(3) { background: var(--color-aqua); }
	.hero-rule span:nth-child(4) { background: var(--color-mist); }
	.hero-rule span:nth-child(5) { background: var(--color-teal); }
	.journal {
		padding-bottom: clamp(72px, 8vw, 112px);
		padding-top: clamp(64px, 7vw, 92px);
		scroll-margin-top: 24px;
	}
	.section-heading {
		align-items: end;
		display: flex;
		justify-content: space-between;
		margin-bottom: 30px;
	}
	.section-heading h2,
	.palette-copy h2,
	.newsletter h2 {
		color: var(--color-teal-deep);
		font: 560 clamp(1.8rem, 3.2vw, 2.5rem)/1.05 var(--font-display);
		letter-spacing: -.035em;
		margin: 0;
	}
	.note-count {
		color: var(--color-teal-deep);
		font-size: 11px;
		font-weight: 650;
		letter-spacing: .04em;
		text-transform: uppercase;
	}
	.note-count span {
		color: var(--color-ink-deep);
		font-variant-numeric: tabular-nums;
		margin-right: 6px;
	}
	.journal-grid {
		display: grid;
		gap: clamp(20px, 2.8vw, 40px);
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.journal-card {
		min-width: 0;
		position: relative;
	}
	.card-link {
		color: var(--color-ink-deep);
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
	}
	.card-art {
		align-items: center;
		aspect-ratio: 4 / 3;
		background: var(--color-teal-deep);
		display: flex;
		justify-content: center;
		overflow: hidden;
		width: 100%;
	}
	.card-art svg {
		height: 100%;
		max-height: 240px;
		width: 100%;
	}
	.card-art path, .card-art circle {
		fill: none;
		stroke: var(--color-mist);
		stroke-linecap: square;
		stroke-linejoin: miter;
		stroke-width: 2;
	}
	.card-art .art-accent { stroke: var(--color-coral); }
	.card-art .art-muted { stroke: var(--color-aqua); }
	.card-copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 16px 0 22px;
	}
	.post-meta {
		align-items: center;
		color: var(--color-teal-deep);
		display: flex;
		font-size: 10px;
		font-weight: 700;
		gap: 12px;
		letter-spacing: .07em;
		text-transform: uppercase;
	}
	.post-meta time { font-variant-numeric: tabular-nums; }
	.card-copy h3 {
		color: var(--color-ink-deep);
		font: 540 clamp(1.35rem, 2.2vw, 1.8rem)/1.12 var(--font-display);
		letter-spacing: -.025em;
		margin: 13px 0 0;
	}
	.post-description {
		color: var(--color-dark-teal);
		display: block;
		font-size: 13px;
		line-height: 1.6;
		margin-top: 12px;
	}
	.card-action {
		align-items: center;
		color: var(--color-teal-deep);
		display: inline-flex;
		font-size: 11px;
		font-weight: 700;
		gap: 8px;
		margin-top: auto;
		padding-top: 17px;
		width: fit-content;
	}
	.registration-rail {
		background: var(--color-coral);
		bottom: 0;
		height: 3px;
		left: 0;
		position: absolute;
		transform: scaleX(.25);
		transform-origin: left center;
		transition: transform 220ms cubic-bezier(.16, 1, .3, 1);
		width: 100%;
	}
	.journal-card.featured .registration-rail { transform: scaleX(.4); }
	.card-link:hover .registration-rail,
	.card-link:focus-visible .registration-rail { transform: scaleX(1); }
	.card-link:hover .card-action,
	.card-link:focus-visible .card-action { color: var(--color-ink-deep); }
	.placeholder .card-copy { border-bottom: 1px solid var(--color-line); }
	.empty-state {
		color: var(--color-dark-teal);
		font-size: 15px;
		grid-column: 1 / -1;
		line-height: 1.6;
		padding: 24px 0;
	}
	.palette-feature {
		background: var(--color-teal-deep);
		color: var(--color-paper);
	}
	.palette-inner {
		align-items: center;
		display: grid;
		gap: clamp(42px, 8vw, 112px);
		grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
		padding-bottom: clamp(70px, 8vw, 104px);
		padding-top: clamp(70px, 8vw, 104px);
	}
	.palette-copy h2 { color: var(--color-paper); }
	.palette-copy > p {
		color: var(--color-mist-wash);
		font-size: 14px;
		line-height: 1.75;
		margin: 18px 0 0;
		max-width: 54ch;
	}
	.palette-copy .action { margin-top: 22px; }
	.palette-swatches {
		align-items: end;
		display: grid;
		gap: clamp(8px, 1vw, 14px);
		grid-template-columns: repeat(5, minmax(0, 1fr));
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.palette-swatches li {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.swatch {
		background: var(--swatch-color);
		border: 1px solid rgb(255 249 241 / 14%);
		display: block;
		height: clamp(92px, 12vw, 154px);
		width: 100%;
	}
	.palette-swatches li:nth-child(even) .swatch { height: clamp(72px, 9.4vw, 120px); }
	.palette-swatches li:nth-child(3) .swatch { height: clamp(108px, 14vw, 174px); }
	.swatch-name {
		color: var(--color-paper);
		font-size: 10px;
		font-weight: 650;
		margin-top: 9px;
	}
	.palette-swatches code {
		color: var(--color-mist);
		font: 600 9px/1.3 var(--font-body);
		margin-top: 3px;
	}
	.newsletter {
		align-items: center;
		display: grid;
		gap: 30px;
		grid-template-columns: 1fr 1fr;
		padding-bottom: clamp(70px, 8vw, 102px);
		padding-top: clamp(70px, 8vw, 102px);
		scroll-margin-top: 28px;
	}
	.newsletter h2 { font-style: italic; }
	.newsletter-copy > p {
		color: var(--color-dark-teal);
		font-size: 13px;
		line-height: 1.6;
		margin: 12px 0 0;
	}
	.newsletter-preview {
		display: grid;
		gap: 9px;
		grid-template-columns: minmax(0, 1fr) auto;
	}
	.newsletter-preview input {
		background: var(--color-paper);
		border: 1px solid var(--color-teal-deep);
		border-radius: 0;
		color: var(--color-ink-deep);
		font: 12px var(--font-body);
		min-height: 44px;
		padding: 0 13px;
	}
	.newsletter-preview input::placeholder { color: var(--color-dark-teal); opacity: 1; }
	.newsletter-preview input:disabled { cursor: not-allowed; opacity: .8; }
	.newsletter-preview button {
		background: var(--color-coral);
		border: 0;
		border-radius: 0;
		color: var(--color-ink-on-coral);
		font: 650 11px var(--font-body);
		min-height: 44px;
		padding: 0 16px;
	}
	.newsletter-preview button:disabled { cursor: not-allowed; opacity: .8; }
	.newsletter-preview > p {
		color: var(--color-dark-teal);
		font-size: 10px;
		grid-column: 1 / -1;
		margin: 1px 0 0;
	}
	.visually-hidden {
		clip: rect(0, 0, 0, 0);
		clip-path: inset(50%);
		height: 1px;
		overflow: hidden;
		position: absolute;
		white-space: nowrap;
		width: 1px;
	}
	@media (max-width: 820px) {
		.hero-inner {
			gap: 28px;
			grid-template-columns: minmax(0, 1fr) minmax(0, .9fr);
			padding-inline: clamp(22px, 5vw, 48px);
		}
		.hero-art { min-height: 320px; }
		.journal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.journal-card:last-child { grid-column: span 2; }
		.journal-card:last-child .card-art { aspect-ratio: 2.15 / 1; }
		.palette-inner { gap: 44px; grid-template-columns: 1fr; }
		.palette-swatches { max-width: 580px; }
		.swatch { height: 128px; }
		.palette-swatches li:nth-child(even) .swatch { height: 104px; }
		.palette-swatches li:nth-child(3) .swatch { height: 148px; }
	}
	@media (max-width: 620px) {
		.hero-inner {
			grid-template-columns: 1fr;
			padding: 38px 20px 22px;
		}
		.hero-copy { padding: 0; }
		h1 { font-size: clamp(2.75rem, 10.5vw, 4.2rem); }
		.hero-copy > p { font-size: 15px; margin-top: 19px; }
		.hero-art { min-height: 250px; }
		.hero-art svg { max-height: 280px; }
		.journal-grid { gap: 25px 18px; }
		.card-copy { padding-top: 13px; }
		.card-copy h3 { font-size: clamp(1.3rem, 5vw, 1.65rem); }
		.post-description { font-size: 12px; }
		.newsletter { grid-template-columns: 1fr; }
	}
	@media (max-width: 460px) {
		.shell { padding-inline: 18px; }
		.hero-inner { padding-inline: 18px; }
		.hero-actions { align-items: stretch; flex-direction: column; }
		.action { justify-content: space-between; width: fit-content; }
		.section-heading { align-items: start; flex-direction: column; gap: 9px; }
		.journal-grid { grid-template-columns: 1fr; }
		.journal-card:last-child { grid-column: auto; }
		.journal-card:last-child .card-art { aspect-ratio: 4 / 3; }
		.palette-swatches { gap: 6px; }
		.swatch-name { font-size: 9px; }
		.palette-swatches code { font-size: 8px; }
		.newsletter-preview { grid-template-columns: 1fr; }
		.newsletter-preview button { width: fit-content; }
	}
	@media (prefers-reduced-motion: reduce) {
		.action, .registration-rail { transition: none; }
	}
</style>
