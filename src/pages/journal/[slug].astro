---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFormat = new Intl.DateTimeFormat('en', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

<SiteLayout title={`${post.data.title} — Fieldnotes`} description={post.data.description}>
	<main>
		<article>
			<header class="article-header">
				<a class="back-link" href="/">← All notes</a>
				<p class="eyebrow">{post.data.category}</p>
				<h1>{post.data.title}</h1>
				<p class="dek">{post.data.description}</p>
				<time datetime={post.data.publishedAt.toISOString()}>
					{dateFormat.format(post.data.publishedAt)}
				</time>
			</header>
			<div class="article-body">
				<Content />
			</div>
			<footer class="article-footer">
				{post.data.tags.length > 0 && (
					<p>
						<span>Filed under</span>
						{post.data.tags.join(' · ')}
					</p>
				)}
				<a class="back-link" href="/">← Back to the journal</a>
			</footer>
		</article>
	</main>
</SiteLayout>

<style>
	main { margin: 0 auto; max-width: 1120px; padding: 0 48px; }
	.article-header {
		margin: 0 auto;
		max-width: 720px;
		padding: 70px 0 55px;
		text-align: center;
	}
	.back-link {
		color: var(--color-muted);
		display: inline-block;
		font: 500 11px/1.4 var(--font-mono);
		text-decoration: none;
	}
	.back-link:hover { color: var(--color-accent); }
	.eyebrow {
		color: var(--color-accent);
		font: 500 11px/1.4 var(--font-mono);
		letter-spacing: .08em;
		margin: 54px 0 20px;
		text-transform: uppercase;
	}
	h1 {
		font: 400 clamp(42px, 7vw, 76px)/1.03 var(--font-display);
		letter-spacing: -.065em;
		margin: 0;
	}
	.dek { color: var(--color-muted); font-size: 17px; line-height: 1.65; margin: 22px auto; max-width: 540px; }
	time { color: var(--color-muted); font: 400 11px/1.4 var(--font-mono); }
	.article-body {
		border-top: 1px solid var(--color-line);
		font: 400 17px/1.85 var(--font-display);
		margin: 0 auto;
		max-width: 680px;
		padding: 38px 0 70px;
	}
	.article-body :global(p) { margin: 0 0 1.5em; }
	.article-body :global(p:first-child)::first-letter {
		color: var(--color-accent);
		float: left;
		font-size: 3.6em;
		line-height: .85;
		margin: .05em .12em 0 0;
	}
	.article-footer {
		align-items: center;
		border-top: 1px solid var(--color-line);
		display: flex;
		justify-content: space-between;
		margin: 0 auto 80px;
		max-width: 680px;
		padding-top: 20px;
	}
	.article-footer p { color: var(--color-ink); font-size: 12px; margin: 0; }
	.article-footer p span { color: var(--color-muted); margin-right: 8px; }
	@media (max-width: 640px) {
		main { padding: 0 22px; }
		.article-header { padding: 50px 0 40px; }
		.eyebrow { margin-top: 42px; }
		.dek { font-size: 15px; }
		.article-body { font-size: 16px; }
		.article-footer { align-items: flex-start; flex-direction: column; gap: 18px; margin-bottom: 56px; }
	}
</style>
