---
interface Props {
	backHref: string;
	backLabel: string;
}

const { backHref, backLabel } = Astro.props;
---

<aside class="draft-banner" aria-label="Local draft preview">
	<span class="draft-status">
		<span class="status-dot" aria-hidden="true"></span>
		Local preview · Draft · Not published
	</span>
	<a href={backHref}>
		<svg aria-hidden="true" viewBox="0 0 18 18">
			<path d="M15 9H4m5 5-5-5 5-5" />
		</svg>
		{backLabel}
	</a>
</aside>

<style>
	.draft-banner {
		align-items: center;
		background: var(--color-teal-deep);
		color: var(--color-paper);
		display: flex;
		gap: 16px;
		justify-content: space-between;
		padding: 12px clamp(22px, 4vw, 48px);
	}
	.draft-status {
		align-items: center;
		color: var(--color-mist-wash);
		display: inline-flex;
		font-size: 11px;
		font-weight: 600;
		gap: 9px;
		letter-spacing: .055em;
		text-transform: uppercase;
	}
	.status-dot {
		background: var(--color-action);
		border-radius: 50%;
		height: 7px;
		width: 7px;
	}
	a {
		align-items: center;
		border-bottom: 1px solid var(--color-action);
		color: var(--color-paper);
		display: inline-flex;
		font-size: 12px;
		font-weight: 600;
		gap: 7px;
		padding-bottom: 3px;
		text-decoration: none;
		white-space: nowrap;
	}
	a:hover { color: var(--color-mist); }
	a:focus-visible {
		outline: 2px solid var(--color-action);
		outline-offset: 4px;
	}
	svg {
		fill: none;
		height: 15px;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-width: 1.5;
		width: 15px;
	}
	@media (max-width: 480px) {
		.draft-banner {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
