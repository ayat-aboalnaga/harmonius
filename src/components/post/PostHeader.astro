---
interface Props {
	title: string;
	category: string;
	publishedAt: Date;
}

const { title, category, publishedAt } = Astro.props;
const dateFormat = new Intl.DateTimeFormat('en', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

<header class="post-header">
	<p class="post-category">{category}</p>
	<h1>{title}</h1>
	<p class="post-meta">
		<time datetime={publishedAt.toISOString()}>{dateFormat.format(publishedAt)}</time>
	</p>
</header>

<style>
	.post-header {
		margin: 0 auto;
		max-width: 880px;
		padding: clamp(56px, 7vw, 88px) clamp(24px, 4vw, 48px) 36px;
		text-align: center;
	}
	.post-category {
		color: var(--color-teal-deep);
		display: inline-block;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: .14em;
		margin: 0;
		text-transform: uppercase;
	}
	.post-category::after {
		background: var(--color-action);
		content: '';
		display: block;
		height: 2px;
		margin: 9px auto 0;
		width: 26px;
	}
	h1 {
		color: var(--color-teal-deep);
		font: 500 clamp(34px, 4.5vw, 52px)/1.1 var(--font-display);
		letter-spacing: -.04em;
		margin: 16px 0 18px;
		text-wrap: balance;
	}
	.post-meta {
		color: var(--color-teal);
		font-size: 13px;
		margin: 0;
	}
	.post-meta time { font-variant-numeric: tabular-nums; }
	@media (max-width: 640px) {
		.post-header { padding-bottom: 28px; }
	}
</style>
