---
interface Props {
	tags: string[];
	backHref?: string;
	backLabel?: string;
}

const { tags, backHref = '/', backLabel = 'Back to the journal' } = Astro.props;
---

<footer class="post-footer">
	{tags.length > 0 && (
		<p class="post-tags">
			<span>Filed under</span>
			{tags.join(' · ')}
		</p>
	)}
	<a href={backHref}>
		{backLabel}
		<svg aria-hidden="true" viewBox="0 0 18 18">
			<path d="M3 9h11M9 4l5 5-5 5" />
		</svg>
	</a>
</footer>

<style>
	.post-footer {
		align-items: center;
		background: var(--color-teal-deep);
		color: var(--color-paper);
		display: flex;
		gap: 24px;
		justify-content: space-between;
		margin: 0 auto 48px;
		max-width: 1100px;
		padding: 28px clamp(24px, 4vw, 40px);
	}
	.post-tags {
		color: var(--color-mist-wash);
		font-size: 12px;
		line-height: 1.6;
		margin: 0;
	}
	.post-tags span {
		color: var(--color-action);
		font-weight: 650;
		margin-right: 8px;
	}
	a {
		align-items: center;
		border-bottom: 1px solid var(--color-action);
		color: var(--color-paper);
		display: inline-flex;
		font-size: 14px;
		font-weight: 600;
		gap: 10px;
		padding-bottom: 4px;
		text-decoration: none;
		white-space: nowrap;
	}
	a:hover { color: var(--color-mist); }
	svg {
		fill: none;
		height: 16px;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-width: 1.5;
		width: 16px;
	}
	@media (max-width: 640px) {
		.post-footer {
			align-items: flex-start;
			flex-direction: column;
			gap: 18px;
			margin-bottom: 32px;
		}
	}
</style>
