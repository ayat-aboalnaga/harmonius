---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f4f2ec" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="/" aria-label="Fieldnotes home">
				<span class="mark" aria-hidden="true">F.</span>
				<span>Fieldnotes</span>
			</a>
			<nav aria-label="Main navigation">
				<a href="/#journal-title">Journal</a>
				<a href="mailto:hello@fieldnotes.design">Contact <span aria-hidden="true">↗</span></a>
			</nav>
		</header>
		<slot />
		<footer class="site-footer">
			<a class="wordmark" href="/" aria-label="Fieldnotes home">
				<span class="mark" aria-hidden="true">F.</span>
				<span>Fieldnotes</span>
			</a>
			<p>An independent journal on design and the everyday.</p>
			<span class="copyright">© {new Date().getFullYear()} Fieldnotes</span>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--color-paper: #f4f2ec;
		--color-ink: #22221f;
		--color-muted: #77766e;
		--color-line: #d9d7cf;
		--color-accent: #4e5c42;
		--font-display: "Playfair Display", Georgia, serif;
		--font-body: "DM Sans", Arial, sans-serif;
		--font-mono: "DM Mono", monospace;
		color-scheme: light;
	}
	* { box-sizing: border-box; }
	html { background: var(--color-paper); scroll-behavior: smooth; }
	body {
		background: var(--color-paper);
		color: var(--color-ink);
		font-family: var(--font-body);
		font-size: 14px;
		margin: 0;
		min-width: 320px;
	}
	a { color: inherit; }
	.site-header, .site-footer {
		align-items: center;
		display: flex;
		justify-content: space-between;
		margin: 0 auto;
		max-width: 1216px;
		padding: 24px 48px;
	}
	.site-header { border-bottom: 1px solid var(--color-line); }
	.wordmark {
		align-items: center;
		display: inline-flex;
		font: 500 13px/1 var(--font-mono);
		gap: 10px;
		letter-spacing: -.04em;
		text-decoration: none;
	}
	.mark {
		align-items: center;
		background: var(--color-ink);
		border-radius: 50%;
		color: var(--color-paper);
		display: inline-flex;
		font: 500 11px/1 var(--font-mono);
		height: 24px;
		justify-content: center;
		width: 24px;
	}
	.site-header nav { display: flex; gap: 30px; }
	.site-header nav a {
		font: 500 11px/1.4 var(--font-mono);
		text-decoration: none;
	}
	.site-header nav a span { color: var(--color-accent); }
	.site-header nav a:hover { color: var(--color-accent); }
	.site-footer {
		align-items: center;
		border-top: 1px solid var(--color-line);
		color: var(--color-muted);
		font-size: 11px;
		gap: 20px;
	}
	.site-footer .wordmark { color: var(--color-ink); }
	.site-footer .mark { background: transparent; border: 1px solid var(--color-line); color: var(--color-ink); }
	.site-footer p { margin: 0; }
	.copyright { font-family: var(--font-mono); }
	@media (max-width: 640px) {
		.site-header, .site-footer { padding-left: 22px; padding-right: 22px; }
		.site-header { padding-bottom: 18px; padding-top: 18px; }
		.site-footer { align-items: flex-start; flex-direction: column; gap: 12px; padding-bottom: 24px; padding-top: 24px; }
	}
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
	}
</style>
