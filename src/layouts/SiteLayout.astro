---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#663732" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="preload"
			href="/fonts/newsreader-latin-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/dm-sans-latin-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="header-inner">
				<a class="wordmark" href="/" aria-label="Fieldnotes home">
					<span class="mark" aria-hidden="true">F.</span>
					<span>Fieldnotes</span>
				</a>
				<nav aria-label="Main navigation">
					<a href="/#journal-title">Journal</a>
					<a href="mailto:hello@fieldnotes.design">
						Contact
						<svg aria-hidden="true" viewBox="0 0 16 16">
							<path d="M4 12 12 4M5 4h7v7" />
						</svg>
					</a>
				</nav>
			</div>
		</header>
		<slot />
		<footer class="site-footer">
			<div class="footer-inner">
				<a class="wordmark" href="/" aria-label="Fieldnotes home">
					<span class="mark" aria-hidden="true">F.</span>
					<span>Fieldnotes</span>
				</a>
				<p>An independent journal on design and the everyday.</p>
				<span class="copyright">© {new Date().getFullYear()} Fieldnotes</span>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Newsreader";
		src: url("/fonts/newsreader-latin-variable.woff2") format("woff2");
		font-style: normal;
		font-weight: 400 700;
		font-display: swap;
	}
	@font-face {
		font-family: "DM Sans";
		src: url("/fonts/dm-sans-latin-variable.woff2") format("woff2");
		font-style: normal;
		font-weight: 400 700;
		font-display: swap;
	}
	:root {
		--color-paper: #f8f3eb;
		--color-ink: #663732;
		--color-coral: #cc6d64;
		--color-aqua: #64c3cc;
		--color-mist: #98c7cc;
		--color-teal: #326166;
		--color-line: #98c7cc;
		--font-display: "Newsreader", Georgia, serif;
		--font-body: "DM Sans", Arial, sans-serif;
		color-scheme: light;
	}
	* { box-sizing: border-box; }
	html {
		background: var(--color-paper);
		scroll-behavior: smooth;
		scrollbar-color: var(--color-teal) var(--color-mist);
	}
	body {
		background: var(--color-paper);
		color: var(--color-ink);
		caret-color: var(--color-ink);
		font-family: var(--font-body);
		font-size: 16px;
		margin: 0;
	}
	::selection {
		background: var(--color-aqua);
		color: var(--color-ink);
	}
	a { color: inherit; text-underline-offset: .2em; }
	a:focus-visible {
		outline: 2px solid var(--color-teal);
		outline-offset: 4px;
	}
	.site-header {
		background: var(--color-ink);
		color: var(--color-paper);
	}
	.header-inner, .footer-inner {
		align-items: center;
		display: flex;
		justify-content: space-between;
		margin: 0 auto;
		max-width: 1440px;
		padding: 18px clamp(22px, 5.2vw, 76px);
	}
	.wordmark {
		align-items: center;
		color: inherit;
		display: inline-flex;
		font: 650 18px/1 var(--font-display);
		gap: 11px;
		letter-spacing: -.025em;
		text-decoration: none;
	}
	.mark {
		align-items: center;
		background: var(--color-aqua);
		color: var(--color-ink);
		display: inline-flex;
		font: 600 13px/1 var(--font-display);
		height: 34px;
		justify-content: center;
		width: 34px;
	}
	.site-header nav {
		align-items: center;
		display: flex;
		gap: clamp(20px, 3vw, 42px);
	}
	.site-header nav a {
		align-items: center;
		color: var(--color-paper);
		display: inline-flex;
		font-size: 12px;
		font-weight: 600;
		gap: 7px;
		text-decoration: none;
	}
	.site-header nav a:hover { color: var(--color-aqua); }
	.site-header a:focus-visible, .site-footer a:focus-visible {
		outline-color: var(--color-aqua);
	}
	.site-header nav svg {
		fill: none;
		height: 13px;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-width: 1.4;
		width: 13px;
	}
	.site-footer {
		background: var(--color-teal);
		color: var(--color-paper);
	}
	.footer-inner {
		gap: 24px;
		min-height: 108px;
	}
	.site-footer .wordmark { font-size: 16px; }
	.site-footer .mark {
		background: var(--color-aqua);
		color: var(--color-ink);
		height: 30px;
		width: 30px;
	}
	.site-footer p {
		font-size: 13px;
		line-height: 1.5;
		margin: 0;
	}
	.copyright {
		font-size: 11px;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	@media (max-width: 640px) {
		.header-inner { padding-bottom: 16px; padding-top: 16px; }
		.wordmark { font-size: 16px; gap: 8px; }
		.mark { height: 30px; width: 30px; }
		.site-header nav { gap: 17px; }
		.site-header nav a { font-size: 11px; }
		.footer-inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 13px;
			padding-bottom: 25px;
			padding-top: 25px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		*, *::before, *::after {
			animation-duration: .01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: .01ms !important;
		}
	}
</style>
