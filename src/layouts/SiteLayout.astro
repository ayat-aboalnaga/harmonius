---
interface Props {
	title: string;
	description: string;
	footerMode?: 'full' | 'compact';
}

const { title, description, footerMode = 'full' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#17302e" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="preload"
			href="/fonts/newsreader-latin-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/dm-sans-latin-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="header-inner">
				<a class="wordmark" href="/" aria-label="Fieldnotes home">
					<span class="mark" aria-hidden="true">F.</span>
					<span>Fieldnotes</span>
				</a>
				<nav aria-label="Main navigation">
					<a href="/#journal-title">Journal</a>
					<a href="/#guides">Guides</a>
					<a href="/#palette-guide">Palette</a>
					<a href="/#studio-preview">Studio</a>
					<a class="header-subscribe" href="/#newsletter">Subscribe</a>
				</nav>
			</div>
		</header>
		<slot />
		<footer class:list={['site-footer', { compact: footerMode === 'compact' }]} id="about">
			<div class="footer-inner">
				{footerMode === 'compact' && (
					<div class="compact-footer">
						<span class="copyright">© {new Date().getFullYear()} Fieldnotes</span>
						<span>Design, detail, everyday.</span>
					</div>
				)}
				{footerMode === 'full' && (
					<>
						<div class="footer-brand">
							<a class="wordmark" href="/" aria-label="Fieldnotes home">
								<span class="mark" aria-hidden="true">F.</span>
								<span>Fieldnotes</span>
							</a>
							<p>An independent journal on design and the everyday.</p>
						</div>
						<nav class="footer-links" aria-label="Footer navigation">
							<div>
								<span class="footer-label">Read</span>
								<a href="/#journal-title">Journal</a>
								<a href="/#guides">Field guides</a>
								<a href="/#palette-guide">Palette</a>
							</div>
							<div>
								<span class="footer-label">Fieldnotes</span>
								<a href="/#studio-preview">Studio preview</a>
								<a href="mailto:hello@fieldnotes.design">Contact</a>
							</div>
						</nav>
						<div class="footer-bottom">
							<span class="copyright">© {new Date().getFullYear()} Fieldnotes</span>
							<span>Design, detail, everyday.</span>
						</div>
					</>
				)}
			</div>
		</footer>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Newsreader";
		src: url("/fonts/newsreader-latin-variable.woff2") format("woff2");
		font-style: normal;
		font-weight: 400 700;
		font-display: swap;
	}
	@font-face {
		font-family: "DM Sans";
		src: url("/fonts/dm-sans-latin-variable.woff2") format("woff2");
		font-style: normal;
		font-weight: 400 700;
		font-display: swap;
	}
	:root {
		--color-paper: #f4eee2;
		--color-ink: #663732;
		--color-ink-deep: #4a2521;
		--color-ink-on-coral: #2b1715;
		--color-coral: #cc6d64;
		--color-action: #f0a368;
		--color-ink-on-action: #17302e;
		--color-coral-wash: #f4d9d5;
		--color-aqua: #64c3cc;
		--color-aqua-wash: #d9eff0;
		--color-mist: #98c7cc;
		--color-mist-wash: #e3f0f1;
		--color-teal: #326166;
		--color-teal-deep: #17302e;
		--color-teal-night: #0f2a28;
		--color-dark-teal: #17302e;
		--color-line: #6f989b;
		--font-display: "Newsreader", Georgia, serif;
		--font-body: "DM Sans", Arial, sans-serif;
		color-scheme: light;
	}
	* { box-sizing: border-box; }
	html {
		background: var(--color-paper);
		scroll-behavior: smooth;
		scrollbar-color: var(--color-teal-deep) var(--color-mist-wash);
	}
	body {
		background: var(--color-paper);
		color: var(--color-ink-deep);
		caret-color: var(--color-ink-deep);
		font-family: var(--font-body);
		font-size: 16px;
		margin: 0;
	}
	::selection {
		background: var(--color-aqua);
		color: var(--color-ink-deep);
	}
	a { color: inherit; text-underline-offset: .2em; }
	a:focus-visible {
		outline: 2px solid var(--color-teal-deep);
		outline-offset: 4px;
	}
	.site-header {
		background: var(--color-teal-deep);
		color: var(--color-paper);
	}
	.header-inner, .footer-inner {
		margin: 0 auto;
		max-width: 1440px;
		padding-inline: clamp(22px, 3.6vw, 52px);
	}
	.site-footer.compact .footer-inner {
		display: block;
		max-width: 1100px;
	}
	.compact-footer {
		align-items: center;
		color: var(--color-mist);
		display: flex;
		font-size: 12.5px;
		justify-content: space-between;
		padding-block: 22px;
	}
	.header-inner {
		align-items: center;
		display: flex;
		justify-content: space-between;
		min-height: 68px;
	}
	.wordmark {
		align-items: center;
		color: inherit;
		display: inline-flex;
		font: 600 22px/1 var(--font-display);
		gap: 11px;
		letter-spacing: -.025em;
		text-decoration: none;
	}
	.mark {
		align-items: center;
		background: var(--color-coral);
		color: var(--color-ink-on-coral);
		display: inline-flex;
		font: 600 13px/1 var(--font-display);
		height: 34px;
		justify-content: center;
		width: 34px;
	}
	.site-header nav {
		align-items: center;
		display: flex;
		gap: clamp(17px, 2.4vw, 32px);
	}
	.site-header nav a {
		align-items: center;
		color: var(--color-paper);
		display: inline-flex;
		font-size: 12px;
		font-weight: 650;
		text-decoration: none;
	}
	.site-header nav a:hover { color: var(--color-mist); }
	.site-header nav .header-subscribe {
		background: var(--color-action);
		color: var(--color-ink-on-action);
		min-height: 40px;
		padding: 0 20px;
	}
	.site-header nav .header-subscribe:hover {
		background: var(--color-aqua);
		color: var(--color-ink-on-action);
	}
	.site-header a:focus-visible, .site-footer a:focus-visible {
		outline-color: var(--color-mist);
	}
	.site-footer {
		background: var(--color-teal-deep);
		color: var(--color-paper);
	}
	.footer-inner {
		display: grid;
		gap: 24px 48px;
		grid-template-columns: minmax(220px, 1fr) auto;
		padding-bottom: 24px;
		padding-top: 40px;
	}
	.site-footer .wordmark { font-size: 16px; }
	.site-footer .mark {
		background: var(--color-coral);
		color: var(--color-ink-on-coral);
		height: 30px;
		width: 30px;
	}
	.site-footer p {
		color: var(--color-mist);
		font-size: 13px;
		line-height: 1.5;
		margin: 17px 0 0;
		max-width: 34ch;
	}
	.footer-links {
		display: flex;
		gap: clamp(42px, 7vw, 100px);
	}
	.footer-links > div {
		align-items: flex-start;
		display: flex;
		flex-direction: column;
		gap: 9px;
	}
	.footer-label {
		color: var(--color-mist);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: .1em;
		margin-bottom: 3px;
		text-transform: uppercase;
	}
	.footer-links a {
		color: var(--color-paper);
		font-size: 11px;
		text-decoration: none;
	}
	.footer-links a:hover { color: var(--color-mist); }
	.footer-bottom {
		border-top: 1px solid rgb(152 199 204 / 25%);
		color: var(--color-mist);
		display: flex;
		font-size: 10px;
		grid-column: 1 / -1;
		justify-content: space-between;
		padding-top: 13px;
	}
	.copyright {
		font-size: 11px;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	@media (max-width: 640px) {
		.header-inner {
			align-items: center;
			flex-wrap: wrap;
			gap: 14px 20px;
			padding-bottom: 13px;
			padding-top: 13px;
		}
		.site-header nav {
			flex: 1 0 100%;
			gap: 6px;
			justify-content: space-between;
			order: 1;
		}
		.site-header nav a { font-size: 9px; }
		.site-header nav .header-subscribe { min-height: 33px; padding-inline: 8px; }
		.header-inner { padding-inline: 18px; }
		.footer-inner {
			gap: 25px;
			grid-template-columns: 1fr;
			padding-bottom: 22px;
			padding-top: 30px;
		}
		.site-footer.compact .footer-inner { padding-block: 0; }
		.compact-footer {
			align-items: flex-start;
			flex-direction: column;
			gap: 8px;
			padding-block: 18px;
		}
		.footer-links { gap: 44px; }
		.footer-bottom {
			align-items: flex-start;
			flex-direction: column;
			gap: 8px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		*, *::before, *::after {
			animation-duration: .01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: .01ms !important;
		}
	}
</style>
